* GF180MCU 3.3 V nFET mismatch (Monte Carlo) example, generated by bootstrap.sh.
*   @NGSPICE@ -b -n mismatch.sp
*
* Mismatch is switched on by `.param sw_stat_mismatch=1` after design.spice
* (which sets it to 0 and gives zero spread). The typical corner includes the
* `fets_mm` library, whose X-prefix subcircuit nfet_03v3 wraps the BSIM4 card
* with, per instance,
*   delvto = agauss(0,var_vth,1)   var_vth = 0.7071*par_vth*1e-6/sqrt(leff*weff)
*   mulu0  = 1 - agauss(0,var_k,1) var_k   = 0.7071*par_k  *1e-6/sqrt(leff*weff)
* with leff = l - par_l, weff = par*(w - par_w), par_vth = 7.148 mV um,
* par_k = 0.7008 % um, par_l = 0.15 um, par_w = -0.1 um (sizes in metres).
* So par_vth and par_k are the pair-difference Pelgrom coefficients of the
* model. `par` multiplies the width in the spread only (the nominal device
* is unchanged), so raising it at fixed W/L gives the spread of a larger
* device in the same model bin, as `mult` does in the SKY130 deck.
* ngspice evaluates agauss once per parse, so this deck re-parses with
* `reset` for every sample, in one ngspice process. `setseed` + `reset`
* before the loop makes the run reproducible; change SEED for an independent
* sample set. The sampling error of a standard deviation from n samples is
* 1/sqrt(2(n-1)).
*
* What it reports, for N = @N@ samples of W/L = @W@/@L@ um, par = @PAR@:
*  - sigma_vtlin_V: standard deviation of Vtlin over 2N single devices (the
*    drawn gate voltage at which Id = 0.1 uA * W/L with Vds = 0.1 V, the
*    definition of GF's mismatch plots, Model Reference Guide section 9.4);
*    sigma_didsat_rel: standard deviation of (Id1 - Id2)/mean(Id1, Id2) over
*    N pairs at Vgs = Vds = 3.3 V (the "sigma(delta Idsat)" of the same plots);
*  - avt_dvt_mVum, aidsat_pcum: sigma(Vtlin)*sqrt(2)*sqrt(W*L*par) and
*    sigma(delta Idsat)*sqrt(W*L*par) with drawn W, L (the plots' 1/sqrt(W*L) axis);
*  - avt_model_mVum, aidsat_model_pcum: the same with leff*weff in place of W*L,
*    to compare with the model's par_vth and par_k.
.include "@MODELS_DIR@/design.spice"
.param sw_stat_mismatch=@MM@
.lib "@MODELS_DIR@/sm141064.spice" typical
.temp 25
.options reltol=1e-6 vntol=1e-9 abstol=1e-13
.param wdev=@W@u ldev=@L@u pdev=@PAR@
.param ithr='0.1u*wdev/ldev'
* two devices for Vtlin, common gate sweep, Vds = 0.1 V
vg gs 0 0
vd1 d1 0 0.1
vd2 d2 0 0.1
X1 d1 gs 0 0 nfet_03v3 w={wdev} l={ldev} par={pdev}
X2 d2 gs 0 0 nfet_03v3 w={wdev} l={ldev} par={pdev}
* two devices for Idsat, Vgs = Vds = 3.3 V
vd3 d3 0 3.3
vd4 d4 0 3.3
X3 d3 gs 0 0 nfet_03v3 w={wdev} l={ldev} par={pdev}
X4 d4 gs 0 0 nfet_03v3 w={wdev} l={ldev} par={pdev}
.control
setplot const
let nrun=@N@
let area=@W@*@L@*@PAR@
let aeff=(@L@-0.15)*@PAR@*(@W@+0.1)
let ts1=0
let ts2=0
let is1=0
let is2=0
let k=0
setseed @SEED@
reset
while k < nrun
  dc vg 0 3.3 0.01
  let id1=-i(vd1)
  let id2=-i(vd2)
  let id3=-i(vd3)
  let id4=-i(vd4)
  let thr=0.1e-6*@W@/@L@
  let n=length(gs)
  * constant-current Vt: first crossing of thr, linear in log(Id) between points
  let vt1=0
  let vt2=0
  let j=1
  while j < n
    if vt1 = 0 & id1[j] >= thr
      let vt1=gs[j-1]+(ln(thr)-ln(id1[j-1]))/(ln(id1[j])-ln(id1[j-1]))*(gs[j]-gs[j-1])
    end
    if vt2 = 0 & id2[j] >= thr
      let vt2=gs[j-1]+(ln(thr)-ln(id2[j-1]))/(ln(id2[j])-ln(id2[j-1]))*(gs[j]-gs[j-1])
    end
    let j=j+1
  end
  let i3=id3[n-1]
  let i4=id4[n-1]
  let dis=(i3-i4)/((i3+i4)/2)
  set st1=$&vt1
  set st2=$&vt2
  set sdi=$&dis
  setplot const
  let ts1=ts1+$st1+$st2
  let ts2=ts2+$st1*$st1+$st2*$st2
  let is1=is1+$sdi
  let is2=is2+$sdi*$sdi
  reset
  let k=k+1
end
setplot const
let n2=2*nrun
let sig_t=sqrt(abs(ts2-ts1*ts1/n2)/(n2-1))
let sig_i=sqrt(abs(is2-is1*is1/nrun)/(nrun-1))
let mean_t=ts1/n2
echo RESULT n_pairs $&nrun
echo RESULT n_devices $&n2
echo RESULT mean_vtlin_V $&mean_t
echo RESULT sigma_vtlin_V $&sig_t
echo RESULT sigma_didsat_rel $&sig_i
let avt=1e3*sig_t*sqrt(2)*sqrt(area)
let avtm=1e3*sig_t*sqrt(2)*sqrt(aeff)
let aid=1e2*sig_i*sqrt(area)
let aidm=1e2*sig_i*sqrt(aeff)
echo RESULT avt_dvt_mVum $&avt
echo RESULT avt_model_mVum $&avtm
echo RESULT aidsat_pcum $&aid
echo RESULT aidsat_model_pcum $&aidm
.endc
.end
