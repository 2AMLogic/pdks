* GF180MCU 3.3 V inverter transfer curve: a minimal working deck
* (generated by bootstrap.sh)   @NGSPICE@ example.sp
*
* design.ngspice sets the statistical switches; sm141064.ngspice holds the
* corners: typical, ff, ss, fs, sf. MOSFETs are BSIM4 .models (M prefix,
* units in metres); the 5 V and DSS devices are subcircuits (X prefix).
.include "@MODELS_DIR@/design.ngspice"
.lib "@MODELS_DIR@/sm141064.ngspice" typical
.temp 25
vdd vdd 0 3.3
vin in 0 0
Mn out in 0   0   nfet_03v3 w=1u l=0.28u
Mp out in vdd vdd pfet_03v3 w=2u l=0.28u
.control
dc vin 0 3.3 0.01
meas dc vm when v(out)=v(in)
echo "RESULT switching_point_V $&vm"
.endc
.end
