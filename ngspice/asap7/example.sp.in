* ASAP7 INVx1 transfer curve: a minimal working deck (generated by bootstrap.sh)
*   @NGSPICE@ example.sp
.lib "@MODELS_DIR@/asap7.lib" tt
.temp 25
vdd vdd 0 0.7
vin in 0 0
Nn out in 0   0   nmos_rvt l=20n nfin=3
Np out in vdd vdd pmos_rvt l=20n nfin=3
.control
pre_osdi @OSDI@
dc vin 0 0.7 0.01
meas dc vm when v(out)=v(in)
echo "RESULT switching_point_V $&vm"
.endc
.end
