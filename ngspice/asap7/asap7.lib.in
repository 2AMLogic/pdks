* ASAP7 r1p7 process corners for ngspice (generated by bootstrap.sh)
*
* Use:   .lib "@MODELS_DIR@/asap7.lib" tt      (or ff, ss)
* Needs: the BSIM-CMG 107 OSDI model loaded first, see spiceinit.
* Devices are OSDI instances, so they take the N prefix:
*   Nn1 d g s b nmos_rvt l=20n nfin=3
* Device names: {n,p}mos_{slvt,lvt,rvt,sram}.

.lib tt
.include "@MODELS_DIR@/7nm_TT.pm"
.endl tt

.lib ff
.include "@MODELS_DIR@/7nm_FF.pm"
.endl ff

.lib ss
.include "@MODELS_DIR@/7nm_SS.pm"
.endl ss
