* ASAP5 r0p4 process corners for ngspice (generated by bootstrap.sh)
*
* Use:   .lib "@MODELS_DIR@/asap5.lib" tt      (or ff, ss, fs, sf)
* Needs: the BSIM-CMG 107 OSDI model loaded first, see spiceinit.
* Devices are OSDI instances (N prefix). One ASAP5 "fin" is a stack of two
* nanowires, so a single-fin device is nfin=2; l defaults to the cards' 14 nm:
*   Nn1 d g s b nmos_rvt nfin=2
* Device names: {n,p}mos_{slvt,lvt,rvt,sram}.

.lib tt
.include "@MODELS_DIR@/asap5_TT.pm"
.endl tt

.lib ff
.include "@MODELS_DIR@/asap5_FF.pm"
.endl ff

.lib ss
.include "@MODELS_DIR@/asap5_SS.pm"
.endl ss

.lib fs
.include "@MODELS_DIR@/asap5_FS.pm"
.endl fs

.lib sf
.include "@MODELS_DIR@/asap5_SF.pm"
.endl sf
