* ASAP5 inverter transfer curve: a minimal working deck (generated by bootstrap.sh)
*   @NGSPICE@ -b -n example.sp
.lib "@MODELS_DIR@/asap5.lib" tt
.temp 25
vdd vdd 0 0.7
vin in 0 0
Nn out in 0   0   nmos_rvt nfin=2
Np out in vdd vdd pmos_rvt nfin=2
.control
pre_osdi @OSDI@
dc vin 0 0.7 0.01
meas dc vm when v(out)=v(in)
echo "RESULT switching_point_V $&vm"
.endc
.end
