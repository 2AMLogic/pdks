* ASAP5 nmos_rvt noise example (.noise), generated by bootstrap.sh.
*   @NGSPICE@ -b -n noise.sp
*
* (VGLO, VGHI = VG -/+ 2 mV, for the gm step.)
* One nmos_rvt (nfin = @NFIN@, the cards' l = 14 nm) with its gate at @VG@ V and drain at
* @VD@ V, the drain through an ideal 1e9 H inductor (a DC short, an AC open,
* and noiseless), so the drain current noise appears across the device's own
* output impedance. `noise v(d) vg ...` gives the output noise and, divided
* by the gain, the input-referred noise.
* The cards set no noise parameter at all (their "noise" section is empty),
* so BSIM-CMG 107's own defaults apply: flicker noia = 6.25e39, noib =
* 3.125e24, noic = 8.75e7, em = 4.1e7, ef = 1.0; thermal ntnoi = 1.0. They
* are the model's generic defaults, not values extracted for ASAP5.
* There is no tnoimod parameter in this release: the thermal noise is the
* charge-based expression 4kT*ntnoi*ueff*qinv/(leff^2 + ueff*qinv*rds).
* ngspice lists several OSDI noise sources under one name, so per-source
* spectra are not used; the total drain noise is.
*
* Results (RESULT lines):
*  - gm_S, id_A: from a +-2 mV gate step at the bias point
*  - gamma_total: the total drain current noise as 4kT*gamma*gm, read at
*    1 MHz (flicker is negligible there); it includes the source/drain
*    resistor noise and the gate-current shot noise
*  - sv_input_1Hz_V2, sv_input_1MHz_V2: input-referred noise, V^2/Hz
*  - flicker_slope: d log (S - S_1MHz) / d log f between 1 and 100 Hz (the
*    model's ef gives -ef)
*  - nyquist_ratio: with the drain at 0 V, the drain current noise over
*    4kT*gds (exactly 1 for any passive conductance in equilibrium)
.lib "@MODELS_DIR@/asap5.lib" tt
.temp 25
vdd d1 0 @VD@
vg g 0 dc @VG@ ac 1
Lb d1 d 1e9
N1 d g 0 0 nmos_rvt nfin=@NFIN@
.control
pre_osdi @OSDI@
let kt4=4*1.380649e-23*298.15
* --- saturation bias point: gm, then noise 1 Hz .. 1 MHz, 10 points/decade
dc vg @VGLO@ @VGHI@ 0.002
let idv=-i(vdd)
let gmv=(idv[2]-idv[0])/0.004
let idb=idv[1]
set gms=$&gmv
set ids=$&idb
noise v(d) vg dec 10 1 1e6 1
setplot noise1
let gm=$gms
let s=inoise_spectrum^2
let gam=s*gm/kt4
let nf=length(frequency)-1
let gam_k=gam[nf]
let svf=s-s[nf]
let slope=(ln(svf[20])-ln(svf[0]))/(ln(frequency[20])-ln(frequency[0]))
let s1=s[0]
let s6=s[nf]
echo RESULT gm_S $gms
echo RESULT id_A $ids
echo RESULT gamma_total $&gam_k
echo RESULT sv_input_1Hz_V2 $&s1
echo RESULT sv_input_1MHz_V2 $&s6
echo RESULT flicker_slope $&slope
* --- Nyquist: drain at 0 V
alter vdd=0
dc vdd -0.001 0.001 0.001
let idz=-i(vdd)
let gdsv=(idz[2]-idz[0])/0.002
set gdss=$&gdsv
noise v(d) vg dec 1 1 1e3 1
setplot noise3
let gds=$gdss
let nyq=onoise_spectrum[3]^2*gds/kt4
let nyq0=nyq
echo RESULT nyquist_ratio $&nyq0
.endc
.end
