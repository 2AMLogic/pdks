* @PDK@ 1.2 V inverter transfer curve: a minimal working deck (generated by
* bootstrap.sh). Run it from this directory, which holds the .spiceinit
* that loads the OSDI models:   @NGSPICE@ -b example.sp
*
* MOS corners in cornerMOSlv.lib: mos_tt, mos_ss, mos_ff, mos_sf, mos_fs.
* Devices are subcircuits (X prefix) wrapping PSP 103; w and l in metres.
.lib "@MODELS_DIR@/cornerMOSlv.lib" mos_tt
.temp 27
vdd vdd 0 1.2
vin in 0 0
Xn out in 0   0   sg13_lv_nmos w=1u l=0.13u ng=1
Xp out in vdd vdd sg13_lv_pmos w=2u l=0.13u ng=1
.control
dc vin 0 1.2 0.01
meas dc vm when v(out)=v(in)
echo "RESULT switching_point_V $&vm"
.endc
.end
