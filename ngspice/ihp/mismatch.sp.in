* @PDK@ @CLASS@ nMOS mismatch (Monte Carlo) example, generated by bootstrap.sh.
* Run it from this directory, which holds the .spiceinit that loads the OSDI
* models:   @NGSPICE@ -b @DECK@
*
* Mismatch comes from the library corner mos_tt_mismatch (cornerMOS@LIBTAG@.lib),
* which includes sg13g2_mos@LIBTAG@_mismatch.lib and sg13g2_mos@LIBTAG@_mod_mismatch.lib.
* The subcircuit draws, per instance and per parse,
*   delvto = agauss(0, delvto_mm/sqrt(m*l*w*1e12), mm_ok)   (V, PSP103 DELVTO)
*   factuo = agauss(1, factuo_mm/sqrt(m*l*w*1e12), mm_ok)   (relative, FACTUO)
*   w, l   = agauss(w, dw_mm, mm_ok), agauss(l, dl_mm, mm_ok)   (absolute, m)
* with w, l in metres, so delvto_mm and factuo_mm are the Pelgrom coefficients
* in V um and um. mm_ok is an instance parameter: 1 draws, 0 switches every
* term off. The default of mm_ok differs between the PDKs (SG13G2: 1;
* SG13CMOS5L: 0), so this deck always passes it explicitly (MM = @MM@).
* ngspice evaluates agauss once per parse, so the deck re-parses with `reset`
* for every sample, in one ngspice process. `setseed` + `reset` before the
* loop makes the run reproducible; change SEED for an independent sample set.
*
* What it reports, for N = @N@ samples of W/L = @W@/@L@ um, m = @M@:
*  - sigma_vt_V: standard deviation of Vt over 2N single devices, Vt being
*    Vgs at Id = 2 uA * W/L, Vds = @VDS@ V (the conditions of IHP's matching
*    coefficient, process specification Attachment A.am).
*  - sigma_dvt_V: standard deviation of the Vt difference of the two devices
*    of a sample (a matched pair).
*  - sigma_beta_rel: spread of beta = peak gm / Vds, relative, over 2N devices.
*  - the Pelgrom products sigma * sqrt(W*L*m).
* The relative standard error of a standard deviation from n samples is
* 1/sqrt(2(n-1)).
.lib "@MODELS_DIR@/cornerMOS@LIBTAG@.lib" mos_tt_mismatch
.temp 27
.options reltol=1e-6 vntol=1e-9 abstol=1e-13
vg gs 0 0
vd3 d3 0 @VDS@
vd4 d4 0 @VDS@
X3 d3 gs 0 0 @DEV@ w=@W@u l=@L@u ng=1 m=@M@ mm_ok=@MM@
X4 d4 gs 0 0 @DEV@ w=@W@u l=@L@u ng=1 m=@M@ mm_ok=@MM@
.control
setplot const
let nrun=@N@
let area=@W@*@L@*@M@
let icc=2e-6*@W@/@L@*@M@
let ds2=0
let ts1=0
let ts2=0
let gs1=0
let gs2=0
let k=0
setseed @SEED@
reset
while k < nrun
  dc vg 0 @VDD@ 0.002
  let id3=-i(vd3)
  let id4=-i(vd4)
  let gm3=deriv(id3)
  let gm4=deriv(id4)
  let gp3=vecmax(gm3)
  let gp4=vecmax(gm4)
  let c3=floor(mean(id3 < icc)*length(id3)+0.5)
  let c4=floor(mean(id4 < icc)*length(id4)+0.5)
  let c3m=c3-1
  let c4m=c4-1
  set a3=$&c3
  set b3=$&c3m
  set a4=$&c4
  set b4=$&c4m
  let vt3=v(gs)[$b3]+(icc-id3[$b3])/(id3[$a3]-id3[$b3])*(v(gs)[$a3]-v(gs)[$b3])
  let vt4=v(gs)[$b4]+(icc-id4[$b4])/(id4[$a4]-id4[$b4])*(v(gs)[$a4]-v(gs)[$b4])
  let bt3=gp3/@VDS@
  let bt4=gp4/@VDS@
  let dv=vt3-vt4
  set sdv=$&dv
  set st3=$&vt3
  set st4=$&vt4
  set sb3=$&bt3
  set sb4=$&bt4
  setplot const
  let ds2=ds2+$sdv*$sdv
  let ts1=ts1+$st3+$st4
  let ts2=ts2+$st3*$st3+$st4*$st4
  let gs1=gs1+$sb3+$sb4
  let gs2=gs2+$sb3*$sb3+$sb4*$sb4
  reset
  let k=k+1
end
setplot const
let n2=2*nrun
* the pair difference has zero mean, so its variance is ds2 / nrun
let sig_d=sqrt(ds2/nrun)
let sig_t=sqrt(abs(ts2-ts1*ts1/n2)/(n2-1))
let mean_b=gs1/n2
let sig_b=sqrt(abs(gs2-gs1*gs1/n2)/(n2-1))/mean_b
let mean_t=ts1/n2
echo RESULT n_pairs $&nrun
echo RESULT n_devices $&n2
echo RESULT mean_vt_V $&mean_t
echo RESULT sigma_vt_V $&sig_t
echo RESULT sigma_dvt_V $&sig_d
echo RESULT sigma_beta_rel $&sig_b
let avt=1e3*sig_t*sqrt(area)
let avt_d=1e3*sig_d*sqrt(area)
let abeta=1e2*sig_b*sqrt(area)
echo RESULT avt_mVum $&avt
echo RESULT avt_pair_mVum $&avt_d
echo RESULT abeta_pcum $&abeta
.endc
.end
