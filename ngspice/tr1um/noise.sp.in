* TR-1um 5 V NMOS noise example, generated by bootstrap.sh.
*   @NGSPICE@ -b -n noise.sp
*
* TR-1um publishes no noise model (reference manual Table I-1-2, "Noise
* model: none"), and the cards set no noise parameter: the BSIM3v3 defaults
* apply (noimod = 1: flicker from noia, noib, noic, em, ef; thermal from the
* charge-based channel expression). This deck therefore shows what those
* defaults give; none of it is a Tokai Rika value.
*
* (VGLO, VGHI = VG -/+ 2 mV, for the gm step.)
* The NMOS (W/L = @W@/@L@ um) has its gate at @VG@ V and drain at @VD@ V,
* the drain through an ideal 1e9 H inductor (a DC short, an AC open, and
* noiseless), so the drain current noise appears across the device's own
* output impedance. `noise v(d) vg ...` gives the output noise and, divided
* by the gain, the input-referred noise; the trailing `1` makes ngspice keep
* each noise source's own spectrum, which is what separates the channel
* thermal noise (".id") from flicker noise (".1overf").
*
* Results (RESULT lines): gm_S, id_A, gamma_thermal, sv_flicker_1Hz_V2 and
* nyquist_ratio, defined as in ngspice/gf180mcu/noise.sp.in. The flicker
* level is 0: BSIM3v3 noimod = 1 scales flicker noise by kf, which defaults
* to 0, so there is no flicker slope to report.
.include "@MODELS_DIR@/ip62_models"
.temp 27
vdd d1 0 @VD@
vg g 0 dc @VG@ ac 1
Lb d1 d 1e9
Xn d g 0 0 NMOS w=@W@u l=@L@u
.control
let kt4=4*1.380649e-23*300.15
* --- saturation bias point: gm, then noise 1 Hz .. 1 MHz, 10 points/decade
dc vg @VGLO@ @VGHI@ 0.002
let idv=-i(vdd)
let gmv=(idv[2]-idv[0])/0.004
let idb=idv[1]
set gms=$&gmv
set ids=$&idb
noise v(d) vg dec 10 1 1e6 1
setplot noise1
let gm=$gms
let gain2=(onoise_spectrum/inoise_spectrum)^2
let sidt=onoise.m.xn.m1.id^2/gain2*gm*gm
let gamma=sidt/(kt4*gm)
let svf=onoise.m.xn.m1.1overf^2/gain2
let gam_k=gamma[30]
let svf1=svf[0]
echo RESULT gm_S $gms
echo RESULT id_A $ids
echo RESULT gamma_thermal $&gam_k
echo RESULT sv_flicker_1Hz_V2 $&svf1
* --- Nyquist: drain at 0 V
alter vdd=0
dc vdd -0.001 0.001 0.001
let idz=-i(vdd)
let gdsv=(idz[2]-idz[0])/0.002
set gdss=$&gdsv
noise v(d) vg dec 1 1 1e3 1
setplot noise3
let gds=$gdss
let nyq=onoise.m.xn.m1.id^2*gds/kt4
let nyq0=nyq[0]
echo RESULT nyquist_ratio $&nyq0
.endc
.end
