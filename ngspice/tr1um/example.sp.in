* TR-1um 5 V inverter transfer curve: a minimal working deck
* (generated by bootstrap.sh)   @NGSPICE@ -b -n example.sp
*
* ip62_models loads every TR-1um model (typical; the corner sets are not
* public). MOSFETs are subcircuits (X prefix), w and l in metres;
* L 1-30 um, W 3.4-60 um.
.include "@MODELS_DIR@/ip62_models"
.temp 25
vdd vdd 0 5
vin in 0 0
Xn out in 0   0   NMOS w=10u l=1u
Xp out in vdd vdd PMOS w=30u l=1u
.control
dc vin 0 5 0.01
meas dc vm when v(out)=v(in)
echo "RESULT switching_point_V $&vm"
.endc
.end
