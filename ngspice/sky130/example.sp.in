* SKY130 1.8 V inverter transfer curve: a minimal working deck
* (generated by bootstrap.sh). Run it from this directory, which holds the
* .spiceinit the library needs:   @NGSPICE@ -b example.sp
*
* Corners: tt, ff, ss, sf, fs (and more in sky130.lib.spice). Devices are
* subcircuits (X prefix); w and l are in microns.
.lib "@PDK_DIR@/libs.tech/ngspice/sky130.lib.spice" tt
.temp 27
vdd vdd 0 1.8
vin in 0 0
Xn out in 0   0   sky130_fd_pr__nfet_01v8 w=1 l=0.15
Xp out in vdd vdd sky130_fd_pr__pfet_01v8 w=2 l=0.15
.control
dc vin 0 1.8 0.01
meas dc vm when v(out)=v(in)
echo "RESULT switching_point_V $&vm"
.endc
.end
