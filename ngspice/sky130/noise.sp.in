* SKY130 1.8 V nFET noise example, generated by bootstrap.sh.
* Run it from this directory, which holds the .spiceinit the library needs:
*   @NGSPICE@ -b noise.sp
*
* (VGLO, VGHI = VG -/+ 2 mV, for the gm step.)
* The nFET (W/L = @W@/@L@ um) has its gate at @VG@ V and drain at @VD@ V,
* the drain through an ideal 1e9 H inductor (a DC short, an AC open, and
* noiseless), so the drain current noise appears across the device's own
* output impedance. `noise v(d) vg ...` gives the output noise and, divided
* by the gain, the input-referred noise; the trailing `1` makes ngspice keep
* each noise source's own spectrum, which is what separates the channel
* thermal noise (".id") from flicker noise (".1overf").
* The library's noise model is BSIM4 with fnoimod=1 and tnoimod=1 (the
* holistic models): noia/ef set the flicker noise, ntnoi/tnoia/tnoib/rnoia/
* rnoib the thermal noise. kf is 0 in every nFET bin and is not used.
*
* Results (RESULT lines):
*  - gm_S, id_A: from a +-2 mV gate step at the bias point
*  - gamma_thermal: channel thermal noise as 4kT*gamma*gm, read at 1 kHz
*    (the .id spectrum is flat to beyond 1 MHz)
*  - sv_flicker_1Hz_V2: input-referred flicker noise at 1 Hz, V^2/Hz
*  - flicker_slope: d log S / d log f of the flicker term between 1 and
*    100 Hz (the model's ef gives -ef)
*  - nyquist_ratio: with the drain at 0 V, channel thermal noise current
*    over 4kT*gds (exactly 1 for any passive conductance in equilibrium)
.lib "@PDK_DIR@/libs.tech/ngspice/sky130.lib.spice" tt
.temp 27
vdd d1 0 @VD@
vg g 0 dc @VG@ ac 1
Lb d1 d 1e9
X1 d g 0 0 sky130_fd_pr__nfet_01v8 w=@W@ l=@L@
.control
let kt4=4*1.380649e-23*300.15
* --- saturation bias point: gm, then noise 1 Hz .. 1 MHz, 10 points/decade
dc vg @VGLO@ @VGHI@ 0.002
let idv=-i(vdd)
let gmv=(idv[2]-idv[0])/0.004
let idb=idv[1]
set gms=$&gmv
set ids=$&idb
noise v(d) vg dec 10 1 1e6 1
setplot noise1
let gm=$gms
let gain2=(onoise_spectrum/inoise_spectrum)^2
let sidt=onoise.m.x1.msky130_fd_pr__nfet_01v8.id^2/gain2*gm*gm
let gamma=sidt/(kt4*gm)
let svf=onoise.m.x1.msky130_fd_pr__nfet_01v8.1overf^2/gain2
let slope=(ln(svf[20])-ln(svf[0]))/(ln(frequency[20])-ln(frequency[0]))
let gam_k=gamma[30]
let svf1=svf[0]
echo RESULT gm_S $gms
echo RESULT id_A $ids
echo RESULT gamma_thermal $&gam_k
echo RESULT sv_flicker_1Hz_V2 $&svf1
echo RESULT flicker_slope $&slope
* --- Nyquist: drain at 0 V
alter vdd=0
dc vdd -0.001 0.001 0.001
let idz=-i(vdd)
let gdsv=(idz[2]-idz[0])/0.002
set gdss=$&gdsv
noise v(d) vg dec 1 1 1e3 1
setplot noise3
let gds=$gdss
let nyq=onoise.m.x1.msky130_fd_pr__nfet_01v8.id^2*gds/kt4
let nyq0=nyq[0]
echo RESULT nyquist_ratio $&nyq0
.endc
.end
