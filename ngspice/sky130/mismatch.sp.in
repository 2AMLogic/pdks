* SKY130 @CLASS@ mismatch (Monte Carlo) example, generated by bootstrap.sh.
* Run it from this directory, which holds the .spiceinit the library needs:
*   @NGSPICE@ -b mismatch.sp
*
* Mismatch is switched on by the library corner: tt_mm sets mc_mm_switch=1
* (so does every other *_mm corner); plain tt sets mc_mm_switch=0 and gives
* zero spread. In the model files each instance draws its own
*   vth0 += agauss(0,1,1) * @DEV@__vth0_slope / sqrt(l*w*mult)
* and the same for every other term the device's own
* @DEV@__mismatch.corner.spice carries: toxe (relative) and voff for the
* nFET; toxe, voff and nfactor for the pFET, whose voff_slope is 0 and so
* adds no variance. w and l are in microns. The slopes come in unsuffixed,
* _slope1 and _slope2 variants and each model bin applies one of them, so
* which value a run sees depends on the bin W/L selects.
* ngspice evaluates agauss once per parse, so this deck re-parses with `reset`
* for every sample, in one ngspice process. `setseed` + `reset` before the
* loop makes the run reproducible; change SEED for an independent sample set.
* Area is W*L*mult. In the library the device line carries no m= for mult:
* mult appears only in the mismatch terms above, so raising it at fixed W/L
* gives the spread of a larger device while the nominal device, its model bin
* and its bias stay the same (a real parallel connection would be m= on the X
* line, which does not shrink the spread in this model).
* Each sample takes about a second (the library is re-read every time).
*
* Bias and sweep voltages are given in device terms (positive = on for either
* polarity) and multiplied by POL = @POL@ (-1 for a pFET), the same
* convention sanity/decks/mos_iv.sp uses. Source and bulk sit at 0 V, so a
* pFET runs on negative gate and drain voltages and a descending gate sweep.
*
* What it reports, for N = @N@ samples of W/L = @W@/@L@ um, mult = @M@:
*  - sigma_dvgs_V: standard deviation of Vgs1 - Vgs2 for two diode-connected
*    devices at equal current (the input-referred offset of a pair at equal
*    drain currents; the loads and tail are taken as ideal and matched).
*  - sigma_vt_V, sigma_beta_rel: spread of the threshold voltage (linear
*    extrapolation at peak gm, |Vds| = @VDS@ V, minus |Vds|/2) and of the
*    current factor beta = gm,peak / |Vds|, over 2N single devices.
*  - the Pelgrom products sigma * sqrt(W*L).
* The relative standard error of a standard deviation from n samples is
* 1/sqrt(2(n-1)).
.lib "@PDK_DIR@/libs.tech/ngspice/sky130.lib.spice" @CORNER@
.temp 27
.options reltol=1e-6 vntol=1e-9 abstol=1e-13
.param wdev=@W@ ldev=@L@ mdev=@M@
.param pol=@POL@
.param ibias='20u*wdev/ldev'
.param vdsn='pol*@VDS@'
* offset pair: equal currents, diode-connected
i1 0 g1 {pol*ibias}
i2 0 g2 {pol*ibias}
X1 g1 g1 0 0 @DEV@ w={wdev} l={ldev} mult={mdev}
X2 g2 g2 0 0 @DEV@ w={wdev} l={ldev} mult={mdev}
* two single devices, common gate sweep, |Vds| = @VDS@ V
vg gs 0 0
vd3 d3 0 {vdsn}
vd4 d4 0 {vdsn}
X3 d3 gs 0 0 @DEV@ w={wdev} l={ldev} mult={mdev}
X4 d4 gs 0 0 @DEV@ w={wdev} l={ldev} mult={mdev}
.control
setplot const
let nrun=@N@
let area=@W@*@L@*@M@
let pol=@POL@
let vstop=pol*@VDD@
let vstep=pol*@VSTEP@
let ds1=0
let ds2=0
let ts1=0
let ts2=0
let gs1=0
let gs2=0
let k=0
setseed @SEED@
reset
while k < nrun
  dc vg 0 $&vstop $&vstep
  let dpair=pol*(v(g1)[0]-v(g2)[0])
  let id3=-pol*i(vd3)
  let id4=-pol*i(vd4)
  let gm3=pol*deriv(id3)
  let gm4=pol*deriv(id4)
  let gp3=vecmax(gm3)
  let gp4=vecmax(gm4)
  let sel3=(gm3 >= gp3)
  let sel4=(gm4 >= gp4)
  let vt3=pol*mean(sel3*v(gs))/mean(sel3)-mean(sel3*id3)/mean(sel3)/gp3-@VDS@/2
  let vt4=pol*mean(sel4*v(gs))/mean(sel4)-mean(sel4*id4)/mean(sel4)/gp4-@VDS@/2
  let bt3=gp3/@VDS@
  let bt4=gp4/@VDS@
  set sd=$&dpair
  set st3=$&vt3
  set st4=$&vt4
  set sb3=$&bt3
  set sb4=$&bt4
  setplot const
  let ds1=ds1+$sd
  let ds2=ds2+$sd*$sd
  let ts1=ts1+$st3+$st4
  let ts2=ts2+$st3*$st3+$st4*$st4
  let gs1=gs1+$sb3+$sb4
  let gs2=gs2+$sb3*$sb3+$sb4*$sb4
  reset
  let k=k+1
end
setplot const
let n2=2*nrun
let sig_d=sqrt(abs(ds2-ds1*ds1/nrun)/(nrun-1))
let sig_t=sqrt(abs(ts2-ts1*ts1/n2)/(n2-1))
let mean_b=gs1/n2
let sig_b=sqrt(abs(gs2-gs1*gs1/n2)/(n2-1))/mean_b
echo RESULT n_pairs $&nrun
echo RESULT n_devices $&n2
let mean_d=ds1/nrun
let mean_t=ts1/n2
let avt_d=1e3*sig_d*sqrt(area)
let avt_t=1e3*sig_t*sqrt(area)
let abeta=1e2*sig_b*sqrt(area)
echo RESULT mean_dvgs_V $&mean_d
echo RESULT sigma_dvgs_V $&sig_d
echo RESULT mean_vt_V $&mean_t
echo RESULT sigma_vt_V $&sig_t
echo RESULT sigma_beta_rel $&sig_b
echo RESULT avt_dvgs_mVum $&avt_d
echo RESULT avt_mVum $&avt_t
echo RESULT abeta_pcum $&abeta
.endc
.end
